rules_version = '2';

// Midknight Treasury — Firestore security rules.
// Any visitor who loads the site is signed in anonymously by the app;
// these rules block everyone else (bots, random API calls).
// Roles/permissions are enforced by the app itself — this is
// team-trust-level security, appropriate for a team budget tracker.
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{doc} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /orders/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
